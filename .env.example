# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Tavily — app.tavily.com (free tier: 1000/month)
TAVILY_API_KEY=tvly-...

# LangSmith — smith.langchain.com (free)
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=job-application-agent

# Infrastructure (Docker Compose starts these)
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET_KEY=change-me-in-production

# MCP (optional — leave blank to use Tavily fallback)
MCP_ENABLED=false
MCP_LINKEDIN_URL=
MCP_GLASSDOOR_URL=
MCP_GITHUB_URL=
